            {content.officeLocations.map((office) => (
              <div
                key={office.name}
                style={{
                  background: "linear-gradient(180deg, #151515, #101010)",
                  border: "1px solid rgba(212, 175, 55, 0.14)",
                  borderRadius: "18px",
                  padding: "28px",
                  boxShadow: "0 10px 30px rgba(0, 0, 0, 0.28)",
                  textAlign: "center",
                }}
              >
                <h3
                  style={{
                    margin: "0 0 14px",
                    color: "#d4af37",
                    fontSize: "1.45rem",
                  }}
                >
                  {office.name}
                </h3>

                <p
                  style={{
                    margin: "0 0 10px",
                    color: "#cbc3b7",
                    lineHeight: 1.7,
                    fontSize: "1.05rem",
                  }}
                >
                  {office.addressLine1}
                  <br />
                  {office.addressLine2}
                </p>

                <a
                  href={`tel:${office.phoneHref}`}
                  style={{
                    color: "#d4af37",
                    textDecoration: "none",
                    fontWeight: 700,
                    fontSize: "1.08rem",
                  }}
                >
                  {office.phoneDisplay}
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>
  );
}